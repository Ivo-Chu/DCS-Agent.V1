# DCS Agent 环境变量示例
#
# CLI、Web、企微和模型验收入口读取项目根目录 .env.local，系统环境变量优先。
# 复制本文件为 .env.local 后填写；值不加引号，不带行尾注释。
# .env.local 已被 Git 忽略，不提交真实凭据或内部地址。
# 占位符仅示意格式，请勿填入真实凭据后提交到 Git。

# ---- LLM（Agent 模型，所有入口必需）----
LLM_API_KEY=your-llm-key
LLM_BASE_URL=https://your-model-host/v1
LLM_MODEL=Qwen3.5-35B

# ---- DCS 数据库（query_dcs_data 工具 + Web/企微身份解析）----
# 任一缺失 → 数据库查询与工号身份解析不可用（工具返回能力不可用，不崩溃）
DCS_DB_USER=your-db-user
DCS_DB_PASSWORD=your-db-password
# 连接串格式：主机:端口/服务名
DCS_DB_CONNECT_STRING=db-host:1521/ORCL
# 业务表所属 schema（S2_Employee 等）。未设置时首次查询自动发现并打印；
# 自动发现失败或多 schema 歧义时需显式指定
# DCS_DB_SCHEMA=DCS_MAIN

# 仅受控 Web 测试：信任输入的工号，允许现有本人菜单及相关表结构查询。生产保持 false。
DCS_ALLOW_WEB_TEST_IDENTITY=false

# ---- 源码调查（investigate_dcs_code 工具）----
# DCS C# 源码根目录，必须设置，否则该工具返回能力不可用（已无代码内默认路径）
DCS_SOURCE_ROOT=D:\your\dcs\source\root
# Tool V2 需要外部 ripgrep；默认从 PATH 查找 rg。也可指定可执行文件绝对路径。
# DCS_RG_PATH=C:\tools\ripgrep\rg.exe

# ---- 知识库（search_dcs_knowledge 工具：本地解析 + LanceDB + 集团 Embedding/Rerank）----
# 资料目录（Markdown/TXT/DOCX/PDF；不递归子目录）：npm run knowledge:ingest 导入
# KNOWLEDGE_DIR=./knowledge/documents
# 本地索引目录（LanceDB + 导入清单）
# KNOWLEDGE_INDEX_DIR=./data/knowledge
# 集团 Embedding 接口：完整请求 URL（代码不追加 /v1/embeddings 之类的路径）+ 凭据
# 两项齐备才启用知识库工具；未配置时工具返回能力不可用，systemPrompt 不注入知识库段
DCS_EMBEDDING_URL=https://your-group-api-host/your/embedding/endpoint
DCS_EMBEDDING_API_KEY=your-embedding-key
# DCS_EMBEDDING_MODEL=Qwen3-Embedding-8B
# 集团 Rerank 接口（可选：未配置时检索降级为向量排序并注明；完整请求 URL）
# DCS_RERANK_URL=https://your-group-api-host/your/rerank/endpoint
# DCS_RERANK_API_KEY=your-rerank-key   # 缺省复用 DCS_EMBEDDING_API_KEY
# DCS_RERANK_MODEL=Qwen3-Reranker-8B
# 单次接口超时毫秒（覆盖响应正文读取全过程，默认 20000）
# DCS_KB_TIMEOUT_MS=20000
# 向量召回候选数（默认 20）与 rerank 返回数（默认 5）
# DCS_KB_CANDIDATES=20
# DCS_KB_TOP_N=5
# embedding 批量大小（默认 16；按接口实测吞吐调整）
# DCS_KB_EMBED_BATCH=16

# ---- 企业微信智能机器人（wecom:bot 入口）----
# 在企业微信管理后台 → 安全与管理 → 智能机器人 创建/配置后获取
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-bot-secret
# Agent 单次处理预算（毫秒，默认 90000）
# WECOM_RUN_BUDGET_MS=90000
# 身份映射手动覆盖文件（可选，优先于数据库解析；默认 ./identity.json）
# DCS_IDENTITY_FILE=./identity.json

# ---- Web 通道（npm run web）----
# WEB_PORT=8787
# WEB_RUN_BUDGET_MS=180000
# 前端静态目录（默认与项目同级的 ../DCS Agent.web，独立目录不随本仓库）
# WEB_STATIC_DIR=../DCS Agent.web
